# Copy to .env.local and fill in what you need. Everything is optional locally.

# Lesson storage (Upstash Redis). Required on Vercel — connecting the
# "Upstash for Redis" Marketplace integration injects KV_REST_API_URL/TOKEN.
# Without these, lessons are saved as JSON files under SAYKI_DATA_DIR.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enables automatic captions (OpenAI Whisper) for non-YouTube video/audio
# links (.mp4, .mp3 …, up to 25 MB). Without it, those links need an
# .srt/.vtt subtitle file.
OPENAI_API_KEY=

# Where lessons are stored as JSON files when Redis is not configured (default: ./.data)
SAYKI_DATA_DIR=
