# Copy to .env.local and fill in what you need. Everything is optional locally.

# Password that locks the whole site (personal use). Required on Vercel: a
# production deployment without it answers every request with 503.
# Locally, leaving it empty keeps `npm run dev` open. Changing it signs out
# every device.
SAYKI_PASSWORD=

# Lesson storage (Upstash Redis). Required on Vercel — connecting the
# "Upstash for Redis" Marketplace integration injects KV_REST_API_URL/TOKEN.
# Without these, lessons are saved as JSON files under SAYKI_DATA_DIR.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rotating RESIDENTIAL proxy used only for YouTube requests. Required on
# Vercel: YouTube bot-checks datacenter IPs. Format:
#   http://username:password@host:port
# Leave empty locally to call YouTube directly.
YOUTUBE_PROXY_URL=

# Claude API key (https://platform.claude.com → API Keys). Enables sentence-by-
# sentence Korean translation, needed for the "Korean → speak English" mode.
ANTHROPIC_API_KEY=
# Optional: model used for translation (default claude-opus-5-5;
# claude-haiku-5-5 is far cheaper).
ANTHROPIC_TRANSLATE_MODEL=
# Optional: max lessons translated per day (default 100) — a cost guard.
TRANSLATE_DAILY_LIMIT=

# Enables automatic captions (OpenAI Whisper) for non-YouTube video/audio
# links (.mp4, .mp3 …, up to 25 MB). Without it, those links need an
# .srt/.vtt subtitle file.
OPENAI_API_KEY=

# Teaching scripts (/script) and uploaded videos (e.g. Instagram reels saved to
# the phone). Claude writes the script (ANTHROPIC_API_KEY) and OpenAI reads it
# aloud (OPENAI_API_KEY); uploaded videos are captioned by Whisper (OPENAI_API_KEY)
# unless a subtitle file comes with them. On Vercel these files need a Blob store
# created with PRIVATE access and connected to the project: that injects
# BLOB_STORE_ID, and functions authenticate with Vercel's OIDC token (a
# BLOB_READ_WRITE_TOKEN also works). Without either, files are saved under
# SAYKI_DATA_DIR/audio and SAYKI_DATA_DIR/media (local development only).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional: model that writes scripts (default claude-opus-5-5).
ANTHROPIC_SCRIPT_MODEL=
# Optional: English voice (defaults gpt-4o-mini-tts / marin; e.g. cedar, coral).
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# Optional: max script drafts and max audio builds per day, each (default 30).
SCRIPT_DAILY_LIMIT=

# Where lessons are stored as JSON files when Redis is not configured (default: ./.data)
SAYKI_DATA_DIR=
